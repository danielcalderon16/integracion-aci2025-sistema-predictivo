# --- PostgreSQL (contenedor local, docker-compose) ---
POSTGRES_USER=aci_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aci_platform
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
# En docker-compose se arma con el host del servicio "db"; en Railway se
# usa el DATABASE_URL que inyecta automáticamente el plugin de Postgres.
DATABASE_URL=postgresql+psycopg2://aci_user:change-me@db:5432/aci_platform
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
# URL pública (navegador) del backend. En docker-compose local suele ser
# http://localhost:8000; en Railway, la URL pública del servicio backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL interna (servidor a servidor) usada por los route handlers de Next.js.
# En docker-compose es el nombre del servicio; en Railway, la URL privada
# o pública del servicio backend.
BACKEND_INTERNAL_URL=http://backend:8000
